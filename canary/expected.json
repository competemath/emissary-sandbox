{
  "about": "What the canary library (canary/lib) must look like after emissary-archangel's tooling has run on it, by capability. Frozen from the first real campaign (run 40729802408, emissary commit 9c65dda3). Changed only by a commit here: see judge/judge.py.",
  "required_capabilities": ["baseline"],
  "capabilities": {
    "baseline": {
      "requires_file": "scripts/bump/tolerant_build.py",
      "expect": {
        "states": {
          "CanaryLib.Clean": "clean",
          "CanaryLib.Broken": "errors",
          "CanaryLib.UsesBroken": "clean"
        }
      }
    },
    "vendor_deps": {
      "requires_file": "scripts/bump/vendor_deps.py",
      "expect": {
        "vendored": ["CanaryDep.Basic"],
        "unsafe": ["CanaryDep.Unsafe"],
        "states": {
          "CanaryDep.Basic": "clean",
          "CanaryLib.UsesDep": "clean",
          "CanaryLib.UsesUnsafe": "bad_import",
          "CanaryLib.AfterUnsafe": "blocked"
        }
      }
    },
    "upstream_dups": {
      "requires_file": "scripts/bump/upstream_dups.py",
      "expect": {
        "removed_declarations": ["Nat.zero_add"],
        "states": {
          "CanaryLib.Shim": "clean",
          "CanaryLib.UsesShim": "clean"
        }
      }
    },
    "lint_repair": {
      "requires_file": "scripts/bump/lint_cli.py",
      "expect": {
        "lint_removed_kinds": ["#print"],
        "lint_violations_after": []
      }
    }
  }
}
